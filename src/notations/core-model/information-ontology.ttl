@prefix : <http://www.semanticweb.org/v0cn037/ontologies/2026/05/information#> .
@prefix conceptual: <http://www.semanticweb.org/v0cn037/ontologies/2026/05/conceptual#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .

<http://www.semanticweb.org/v0cn037/ontologies/2026/05/information> rdf:type owl:Ontology ;
    owl:versionInfo "1.0" ;
    rdfs:label "Information Model (Informationsmodel) OWL Ontology"@en , "Informationsmodel OWL-ontologi"@da ;
    rdfs:comment "A formal OWL ontology representing the Information Model notation with UML relationships, type references, and conceptual traceability."@en ;
    dct:title "Information Model OWL Ontology" ;
    dct:creator "xArchi Knowledge Graph Studio Agent" ;
    dct:created "2026-05-31"^^xsd:date .

### =========================================================================
### 1. Core Classes
### =========================================================================

:Information_Class rdf:type owl:Class ;
    rdfs:label "Information Class"@en , "Informationsklasse"@da ;
    rdfs:comment "A logical data structure or class in the information model."@en .

:DataType rdf:type owl:Class ;
    rdfs:label "Data Type"@en , "Datatype"@da ;
    rdfs:comment "A structured datatype used to represent complex attribute formats."@en .

:Enumeration rdf:type owl:Class ;
    rdfs:label "Enumeration"@en , "Enumeration"@da ;
    rdfs:comment "A closed set of literals or codes."@en .


### =========================================================================
### 2. Object Properties (UML & Traceability Relations)
### =========================================================================

:Information_Relationship rdf:type owl:ObjectProperty ;
    rdfs:label "Information Relationship"@en , "Informationsrelation"@da .

### Generalization (Arv)
:generalizes rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :Information_Relationship ;
    owl:inverseOf :specializes_of ;
    rdfs:domain :Information_Class ;
    rdfs:range :Information_Class ;
    rdfs:label "generalizes"@en , "generaliserer"@da ;
    rdfs:comment "Generalization relationship between information classes."@en .

:specializes_of rdf:type owl:ObjectProperty ;
    rdfs:label "specializes of"@en , "specialiserer af"@da .

### Association
:associates_with rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:subPropertyOf :Information_Relationship ;
    rdfs:domain :Information_Class ;
    rdfs:range :Information_Class ;
    rdfs:label "associates with"@en , "associerer med"@da ;
    rdfs:comment "An association between information classes."@en .

### Aggregation
:aggregates rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:subPropertyOf :Information_Relationship ;
    owl:inverseOf :aggregated_in ;
    rdfs:domain :Information_Class ;
    rdfs:range :Information_Class ;
    rdfs:label "aggregates"@en , "aggregerer"@da ;
    rdfs:comment "Aggregation relationship where the part can exist independently of the whole."@en .

:aggregated_in rdf:type owl:ObjectProperty ;
    rdfs:label "aggregated in"@en , "aggregeres i"@da .

### Composition
:composed_of rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:subPropertyOf :Information_Relationship ;
    owl:inverseOf :composed_in ;
    rdfs:domain :Information_Class ;
    rdfs:range :Information_Class ;
    rdfs:label "composed of"@en , "sammensat af"@da ;
    rdfs:comment "Composition relationship representing a strong whole-part hierarchy."@en .

:composed_in rdf:type owl:ObjectProperty ;
    rdfs:label "composed in"@en , "indgår i sammensætning af"@da .

### Type reference (has_type / is_type_of)
:has_type rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :Information_Relationship ;
    owl:inverseOf :is_type_of ;
    rdfs:domain :Information_Class ;
    rdfs:range [ rdf:type owl:Class ;
                 owl:unionOf (:DataType :Enumeration)
               ] ;
    rdfs:label "has type"@en , "har type"@da ;
    rdfs:comment "Associates an information class to a structured datatype or enumeration."@en .

:is_type_of rdf:type owl:ObjectProperty ;
    rdfs:label "is type of"@en , "er type for"@da .

### Traceability / Derivation (wasDerivedFrom / hasDerivative)
:wasDerivedFrom rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :Information_Relationship ;
    owl:inverseOf :hasDerivative ;
    rdfs:domain :Information_Class ;
    rdfs:range conceptual:Conceptual_Class ;
    rdfs:label "was derived from"@en , "blev afledt af"@da ;
    rdfs:comment "Traceability link from an information class back to its conceptual model origin."@en .

:hasDerivative rdf:type owl:ObjectProperty ;
    rdfs:label "has derivative"@en , "har afledning"@da .
